users_export*.json
*_export.json
.firebase/
firebase-debug.log

# Secrets / env
.env
.env.*
*.key
*.pem
service-account*.json

# Editor / OS junk
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Local node_modules if anything pulls them in
node_modules/

# game asset working files (not for prod)
apps/assets/img/game-preview/
apps/assets/img/player_old.png
apps/assets/img/player_prevC.png

# Editing backups - Droplet writes these beside a file before patching it.
# They belong in E:/Containers/ops/hub-backups, not here (2026-09-19, L: "I'm getting a bunch of back files in my repo").
*.bak
*.bak-*
*.bak.*

__pycache__/
*.pyc
# generated by the graphify post-commit hook (the Louverse code map) - never commit

